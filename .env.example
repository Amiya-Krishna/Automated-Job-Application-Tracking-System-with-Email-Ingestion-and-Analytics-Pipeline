# ===================================
# Environment Variables Template
# ===================================
# Copy this file to .env and update with your values
# NEVER commit the .env file to version control

# ===================================
# Database Configuration
# ===================================
# MongoDB connection string
# For local MongoDB:
MONGODB_URI=mongodb://localhost:27017/job-tracker

# For MongoDB Atlas (Cloud):
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/dbname?retryWrites=true&w=majority

# ===================================
# Server Configuration
# ===================================
# Server port
PORT=5000

# Node environment (development, production, test)
NODE_ENV=development

# ===================================
# JWT Configuration
# ===================================
# Secret key for JWT token generation - use a strong, random string
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production_12345

# JWT token expiration time (in days or hours)
JWT_EXPIRE=7d

# ===================================
# Frontend Configuration
# ===================================
# Frontend URL for CORS setup
CLIENT_URL=https://job-application-tracker-portal-ao8n.vercel.app,http://localhost:5173

# API base URL for frontend
VITE_API_URL=https://job-application-tracker-portal-o1ls.onrender.com

# ===================================
# CORS Configuration
# ===================================
# Allowed origins for CORS (comma-separated for multiple)
CORS_ORIGIN=http://localhost:5173

# ===================================
# Email Configuration (Optional - for future features)
# ===================================
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_app_password
# EMAIL_FROM=noreply@jobtracker.com

# ===================================
# Logging Configuration (Optional)
# ===================================
# LOG_LEVEL=info
# LOG_FILE=logs/app.log

# ===================================
# Session Configuration
# ===================================
# Session secret for express-session (if using)
SESSION_SECRET=your_session_secret_key_here

# ===================================
# Gmail Integration (Optional)
# ===================================
# Create these at https://console.cloud.google.com/apis/credentials
# (OAuth client type: "Web application"). See docs/GMAIL_INTEGRATION.md
# for the full step-by-step setup.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match an "Authorized redirect URI" on the OAuth client,
# and must point at your deployed BACKEND url + /api/gmail/callback
GOOGLE_REDIRECT_URI=http://localhost:5000/api/gmail/callback

