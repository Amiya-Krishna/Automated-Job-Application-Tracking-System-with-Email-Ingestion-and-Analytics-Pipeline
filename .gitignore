# ==========================
# Dependencies
# ==========================
node_modules/
.pnp
.pnp.js

# ==========================
# Environment variables
# (.env.example stays tracked — gitignore matches exact filenames only,
# so it's never caught by the patterns below)
# ==========================
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# ==========================
# Logs
# ==========================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ==========================
# Build output
# ==========================
build/
dist/
dist-ssr/
*.local

# ==========================
# Prisma generated client
# (Prisma 7 generates outside node_modules by default — this catches
# server/generated/prisma regardless of exactly where it lands)
# ==========================
**/generated/prisma/

# ==========================
# Playwright (scraper + apply engine)
# ==========================
server/playwright-profile/
server/screenshots/*
!server/screenshots/.gitkeep
playwright-report/
test-results/

# ==========================
# Vercel (client deploys via vercel.json)
# ==========================
.vercel

# ==========================
# Browser extension packaging
# (zipped/crx builds produced when packing the extension for the store)
# ==========================
browser-extension/*.zip
browser-extension/*.crx
browser-extension/*.pem

# ==========================
# OS files
# ==========================
.DS_Store
Thumbs.db
desktop.ini

# ==========================
# Editor / IDE
# ==========================
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ==========================
# Coverage / test artifacts
# ==========================
coverage/
*.tsbuildinfo

# ==========================
# Misc
# ==========================
*.pem
.eslintcache