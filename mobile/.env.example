# Copy to mobile/.env for LOCAL development only. mobile/.env is gitignored.
# Release builds (staging/production) take their values from EAS environment
# variables instead — see MOBILE_PRODUCTION_IMPLEMENTATION.md. Only variables
# prefixed EXPO_PUBLIC_ are inlined into the JS bundle: NEVER put a secret in one.

# development | staging | production  (eas.json sets this for release builds)
EXPO_PUBLIC_APP_ENV=development

# Base URL of the backend API (server/), no trailing slash. Release builds MUST be https://.
#   Android emulator:        http://10.0.2.2:5000
#   Physical device (LAN):   http://<your-computer's-LAN-IP>:5000
#   Production:              https://job-application-tracker-portal-o1ls.onrender.com
EXPO_PUBLIC_API_URL=

# Optional: base URL of the TrackTrail web app (PDF/Word export hand-off).
EXPO_PUBLIC_WEB_URL=

# Optional: request timeout in ms (default 45000; Render free tier cold starts can take ~30-60s).
# EXPO_PUBLIC_API_TIMEOUT_MS=45000

# Crash reporting. A Sentry DSN is a public identifier (not a secret). Leave blank to disable.
EXPO_PUBLIC_SENTRY_DSN=

# Public legal URLs shown in the app (defaults to <API_URL>/legal/*.html served by the backend).
# EXPO_PUBLIC_PRIVACY_URL=
# EXPO_PUBLIC_TERMS_URL=
# EXPO_PUBLIC_DELETE_ACCOUNT_URL=
# EXPO_PUBLIC_SUPPORT_EMAIL=

# ---- Build-time only (NOT bundled; set as EAS env/secrets, see docs) ----
# APP_LINK_HOST=                 host for https deep links (defaults to the API host)
# GOOGLE_SERVICES_JSON=          EAS *file* variable pointing at google-services.json (Android push)
# SENTRY_ORG= / SENTRY_PROJECT=  and SENTRY_AUTH_TOKEN (secret) for source-map upload
