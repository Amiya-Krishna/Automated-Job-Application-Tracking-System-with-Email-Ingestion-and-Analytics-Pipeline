# Base URL of the existing backend API (server/). No trailing slash.
# Consumed by mobile/services/api.ts via EXPO_PUBLIC_API_URL — Expo only
# inlines env vars prefixed with EXPO_PUBLIC_ into the app bundle, so this
# exact prefix is required.
#
# IMPORTANT: "localhost" / "127.0.0.1" from an Android emulator or a
# physical device refers to the device itself, NOT your development
# machine. Use the values below instead:
#
#   Android emulator (AVD):
#     EXPO_PUBLIC_API_URL=http://10.0.2.2:5000
#     (10.0.2.2 is the emulator's alias for your host machine's localhost)
#
#   Physical Android device (Expo Go / dev build, same Wi-Fi as your computer):
#     EXPO_PUBLIC_API_URL=http://<your-computer's-LAN-IP>:5000
#     (e.g. http://192.168.1.42:5000 — find it with `ipconfig`/`ifconfig`;
#     your phone and computer must be on the same network, and the
#     server's PORT must be reachable through your OS firewall)
#
#   Production:
#     EXPO_PUBLIC_API_URL=https://job-application-tracker-portal-o1ls.onrender.com
#     (the same Render backend the web client already uses — see
#     server/.env.example's CLIENT_URL for context)
#
# Copy this file to mobile/.env and fill in the value for whichever
# environment you're running against. mobile/.env is gitignored.
EXPO_PUBLIC_API_URL=

# Optional: base URL of the TrackTrail web app (no trailing slash). Only used to
# offer "PDF / Word on web" in the Resume Tailoring export section, because
# PDF/DOCX files are generated on the backend and downloaded from the web app.
# Example: https://job-application-tracker-portal-ten.vercel.app
EXPO_PUBLIC_WEB_URL=
