# ---------------------------------------------------------------------------
# AI Resume Tailoring  (see docs/RESUME_TAILORING.md -> "AI Provider Configuration")
# ---------------------------------------------------------------------------
# Parsing, JD analysis, matching, ATS scoring and all validation are
# deterministic and need NO AI. An LLM is optional and is ONLY used to propose
# bullet rewordings; every proposal is re-checked by the no-fabrication
# validator. With AI_PROVIDER=none (or a missing key/model) the feature still
# works in reorder-only mode.
#
# SECURITY: these are SERVER-ONLY secrets. Never put them in client/.env,
# mobile/.env, or the browser extension, and never commit a real .env file.

# AI provider: none | gemini | groq | openrouter   (also: anthropic | openai | openai-compatible)
AI_PROVIDER=none

# Primary AI provider
AI_API_KEY=
# Model id EXACTLY as listed in your provider's current documentation. There is
# deliberately no default: models get retired and free tiers change.
AI_MODEL=
# Optional. Provider defaults live in server/services/resumeTailoring/providers/config.js
#   gemini      https://generativelanguage.googleapis.com/v1beta
#   groq        https://api.groq.com/openai/v1
#   openrouter  https://openrouter.ai/api/v1
# Must be https (http is only accepted for localhost).
AI_BASE_URL=

# Optional fallback, used ONLY for timeouts, network errors, rate limits (429)
# and provider 5xx errors. Never for auth/config errors or invalid output.
AI_FALLBACK_PROVIDER=
AI_FALLBACK_API_KEY=
AI_FALLBACK_MODEL=
AI_FALLBACK_BASE_URL=

# Optional AI configuration
AI_TIMEOUT_MS=45000
AI_MAX_RETRIES=2
AI_OMIT_TEMPERATURE=false
# AI_MAX_OUTPUT_TOKENS=          # override the per-provider default
# AI_LOG_LEVEL=silent            # provider logs are metadata-only; "silent" disables them
# AI_OPENROUTER_REFERER=         # optional, non-secret OpenRouter attribution headers
# AI_OPENROUTER_TITLE=

# Per-user, per-hour rate limits for /api/resume/* (in-memory, per instance)
# RESUME_RL_ANALYZE=60
# RESUME_RL_TAILOR=15
# RESUME_RL_UPLOAD=10
# RESUME_RL_EXPORT=60
# RESUME_RL_READ=600
