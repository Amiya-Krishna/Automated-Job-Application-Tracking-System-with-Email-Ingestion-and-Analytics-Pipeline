CLIENT_URL=https://job-application-tracker-portal-ten.vercel.app,http://localhost:5173
PORT=5000
JWT_SECRET=

# Gmail integration (leave blank to keep the feature disabled)
GOOGLE_CLIENT_ID=     
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://job-application-tracker-portal-o1ls.onrender.com/api/gmail/callback

# Base URL of this server (used to build the fallback Gmail-success page
# for the extension flow below). Leave as-is if this matches your deploy.
SERVER_URL=https://job-application-tracker-portal-o1ls.onrender.com

# Browser extension Gmail OAuth (same-tab flow).
# IMPORTANT: this is the Chrome extension ID, NOT a chromiumapp.org URL.
# Example: EXTENSION_ID=abcdefghijklmnopabcdefghijklmnop
EXTENSION_ID=

# Server-side relay page used after Google redirects to GOOGLE_REDIRECT_URI.
# Leave this empty to use SERVER_URL + /extension/gmail-success.html.
# EXTENSION_REDIRECT_URL=https://job-application-tracker-portal-o1ls.onrender.com/extension/gmail-success.html

# Forgot-password emails (Resend free tier: https://resend.com/api-keys)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Playwright apply/scrape worker
PLAYWRIGHT_PROFILE_DIR=./playwright-profile
PLAYWRIGHT_HEADLESS=true

# --- New: Intelligent Job Application Engine ---
DATABASE_URL=

# Production (Upstash later)
REDIS_URL=

# Local
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# ---------------------------------------------------------------------------
# AI Resume Tailoring  (see docs/RESUME_TAILORING.md -> "AI Provider Configuration")
# ---------------------------------------------------------------------------
# Parsing, JD analysis, matching, ATS scoring and all validation are
# deterministic and need NO AI. An LLM is optional and is ONLY used to propose
# bullet rewordings; every proposal is re-checked by the no-fabrication
# validator. With AI_PROVIDER=none (or a missing key/model) the feature still
# works in reorder-only mode.
#
# SECURITY: these are SERVER-ONLY secrets. Never put them in client/.env,
# mobile/.env, or the browser extension, and never commit a real .env file.

# AI provider: none | gemini | groq | openrouter   (also: anthropic | openai | openai-compatible)
AI_PROVIDER=none

# Primary AI provider
AI_API_KEY=
# Model id EXACTLY as listed in your provider's current documentation. There is
# deliberately no default: models get retired and free tiers change.
AI_MODEL=
# Optional. Provider defaults live in server/services/resumeTailoring/providers/config.js
#   gemini      https://generativelanguage.googleapis.com/v1beta
#   groq        https://api.groq.com/openai/v1
#   openrouter  https://openrouter.ai/api/v1
# Must be https (http is only accepted for localhost).
AI_BASE_URL=

# Optional fallback, used ONLY for timeouts, network errors, rate limits (429)
# and provider 5xx errors. Never for auth/config errors or invalid output.
AI_FALLBACK_PROVIDER=
AI_FALLBACK_API_KEY=
AI_FALLBACK_MODEL=
AI_FALLBACK_BASE_URL=

# Optional AI configuration
AI_TIMEOUT_MS=45000
AI_MAX_RETRIES=2
AI_OMIT_TEMPERATURE=false
# AI_MAX_OUTPUT_TOKENS=          # override the per-provider default
# AI_LOG_LEVEL=silent            # provider logs are metadata-only; "silent" disables them
# AI_OPENROUTER_REFERER=         # optional, non-secret OpenRouter attribution headers
# AI_OPENROUTER_TITLE=

# Per-user, per-hour rate limits for /api/resume/* (in-memory, per instance)
# RESUME_RL_ANALYZE=60
# RESUME_RL_TAILOR=15
# RESUME_RL_UPLOAD=10
# RESUME_RL_EXPORT=60
# RESUME_RL_READ=600

# ---------------------------------------------------------------------------
# Mobile sessions, push notifications and deep links
# ---------------------------------------------------------------------------
# Set NODE_ENV=production on the host. Enables HSTS, generic 5xx messages and
# stricter password-reset redirect validation.
NODE_ENV=production

# Access token lifetime (seconds) and refresh-token lifetime (days) for the mobile app.
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=60

# Expo push. EXPO_ACCESS_TOKEN is optional (only if you enable "enhanced push security" in Expo).
EXPO_ACCESS_TOKEN=

# Reminder scheduler. On a host that sleeps (Render free tier) set
# REMINDERS_ENABLED=false and call POST /api/notifications/run-reminders from
# .github/workflows/reminders-cron.yml using CRON_SECRET (a long random string).
REMINDERS_ENABLED=true
REMINDER_INTERVAL_MINUTES=15
CRON_SECRET=
# FOLLOW_UP_AFTER_DAYS=7
# JOB_REMINDER_MIN_SCORE=70

# Verified deep links. APP_LINK_BASE_URL is the public https origin of THIS server; when set,
# mobile password-reset emails carry an https App Link (with web fallback) instead of a custom scheme.
APP_LINK_BASE_URL=https://job-application-tracker-portal-o1ls.onrender.com
# Android: SHA-256 fingerprint(s) of the Play App Signing key (Play Console -> App integrity),
# plus your upload key if you sideload release builds. Comma-separated.
ANDROID_PACKAGE_NAME=com.tracktrail.mobile
ANDROID_SHA256_CERT_FINGERPRINTS=
# iOS: 10-character Apple Developer Team ID.
IOS_BUNDLE_ID=com.tracktrail.mobile
APPLE_TEAM_ID=


# --- Roles / admin ---------------------------------------------------------
# Comma-separated emails promoted to role "admin" at boot (accounts must already exist; never demotes).
# Alternative: `npm run make-admin -- you@example.com`. Admins get Job Discovery + the Admin panel
# and are the only users who can delete Sources, Companies and Matched Jobs, and who can list, block,
# unblock and delete normal users (never other admins or themselves).
ADMIN_EMAILS=

# Self-service account deletion (DELETE /api/auth/account): max attempts per user per hour.
# RL_DELETE_MAX=5

# --- Job-board discovery (Naukri / Internshala / Wellfound / Unstop / LinkedIn / Indeed) ---
# Max listings per run that get a detail-page visit for description/salary/skills.
# SCRAPE_DETAIL_LIMIT=15
# SCRAPE_SELECTOR_WAIT_MS=15000   # how long to wait for posting links on a search page before giving up
