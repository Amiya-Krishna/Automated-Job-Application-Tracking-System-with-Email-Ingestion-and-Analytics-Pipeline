# TrackTrail local development environment
# Copy to server/.env.local. Never commit .env.local.

CLIENT_URL=http://localhost:5173
PORT=5000
JWT_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/gmail/callback

SERVER_URL=http://localhost:5000
EXTENSION_ID=
EXTENSION_REDIRECT_URL=http://localhost:5000/extension/gmail-success.html

RESEND_API_KEY=
RESEND_FROM_EMAIL=

PLAYWRIGHT_PROFILE_DIR=./playwright-profile
PLAYWRIGHT_HEADLESS=true

# Separate LOCAL PostgreSQL database only
DATABASE_URL=

REDIS_URL=redis://127.0.0.1:6379
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=
AI_FALLBACK_PROVIDER=
AI_FALLBACK_API_KEY=
AI_FALLBACK_MODEL=
AI_FALLBACK_BASE_URL=
AI_TIMEOUT_MS=45000
AI_MAX_RETRIES=2
AI_OMIT_TEMPERATURE=false

NODE_ENV=development
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=60
EXPO_ACCESS_TOKEN=

REMINDERS_ENABLED=true
REMINDER_INTERVAL_MINUTES=15
CRON_SECRET=

APP_LINK_BASE_URL=http://localhost:5000
ANDROID_PACKAGE_NAME=com.tracktrail.mobile
ANDROID_SHA256_CERT_FINGERPRINTS=
IOS_BUNDLE_ID=com.tracktrail.mobile
APPLE_TEAM_ID=

# Optional:
# AI_MAX_OUTPUT_TOKENS=
# AI_LOG_LEVEL=silent
# AI_OPENROUTER_REFERER=
# AI_OPENROUTER_TITLE=
# FOLLOW_UP_AFTER_DAYS=7
# JOB_REMINDER_MIN_SCORE=70
# RESUME_RL_ANALYZE=60
# RESUME_RL_TAILOR=15
# RESUME_RL_UPLOAD=10
# RESUME_RL_EXPORT=60
# RESUME_RL_READ=600
