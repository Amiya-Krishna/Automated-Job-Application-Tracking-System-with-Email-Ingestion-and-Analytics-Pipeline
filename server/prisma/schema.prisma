generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// ----------------------
/// FIXED: User (mapped from users)
/// ----------------------
model User {
  id                 Int       @id @default(autoincrement())
  name               String    @db.VarChar(255)
  email              String    @unique @db.VarChar(255)
  password           String    @db.VarChar(255)
  gmailRefreshToken  String?   @map("gmail_refresh_token")
  createdAt          DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)

  trackedJobs        TrackedJob[]
  scrapeRuns         ScrapeRun[]
  userProfile        user_profile?
  resumes            Resume[]
  jobDescriptions    JobDescription[]
  resumeAnalyses     ResumeAnalysis[]
  resumeVersions     ResumeVersion[]
  tailoringSessions  TailoringSession[]

  @@map("users")
}

/// ----------------------
/// FIXED: TrackedJob (mapped from tracked_jobs)
/// ----------------------
model TrackedJob {
  id               Int       @id @default(autoincrement())
  userId           Int       @map("user_id")
  company          String    @db.VarChar(255)
  role             String    @db.VarChar(255)
  applicationDate  DateTime  @default(dbgenerated("CURRENT_DATE")) @map("application_date") @db.Date
  status           String?   @default("Applied") @db.VarChar(50)
  interviewDate    String?   @map("interview_date") @db.VarChar(50)
  notes            String?
  // Source attribution so the Applied Jobs UI (and the engine bridge) can
  // tell a hand-typed row apart from one captured by the extension. Kept
  // optional/string (not an FK to job_sources) so existing rows and the
  // manual-add flow keep working with zero migration risk.
  sourceName       String?   @default("manual") @map("source_name") @db.VarChar(50)
  sourceUrl        String?   @map("source_url") @db.VarChar(1000)
  externalJobId    String?   @map("external_job_id") @db.VarChar(255)
  description      String?   @map("description")
  location         String?   @map("location") @db.VarChar(255)
  // Points at the row this manual job was bridged into in the engine
  // `jobs` table (see server/services/engineBridge.js), once enough data
  // exists to enqueue it for matching. Null until that happens.
  engineJobId      BigInt?   @map("engine_job_id")
  createdAt        DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime? @default(now()) @map("updated_at") @db.Timestamptz(6)

  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, applicationDate(sort: Desc)], map: "idx_tracked_jobs_user_application_date")
  @@index([userId], map: "idx_tracked_jobs_user_id")
  // BUG FIX (Applied Jobs / Engine Job apply flow): applying to an Engine
  // Job (POST /api/applications/:jobId) needs to find-or-create exactly
  // one TrackedJob per (user, engine job) so repeated clicks are
  // idempotent instead of stacking up duplicate rows. NULLs are exempt
  // from Postgres unique-constraint checks, so this only ever constrains
  // rows that ARE bridged to an engine job — manual jobs (engineJobId
  // null) are completely unaffected and can still have any number of
  // rows per user.
  @@unique([userId, engineJobId], map: "uq_tracked_jobs_user_engine_job")

  @@map("tracked_jobs")
}

/// ----------------------
/// NEW: ScrapeRun — tracks dashboard-triggered discovery runs so the UI
/// can show honest queued/running/succeeded/failed/blocked status instead
/// of a fire-and-forget button with no feedback.
/// ----------------------
model ScrapeRun {
  id            Int       @id @default(autoincrement())
  userId        Int       @map("user_id")
  query         String    @db.VarChar(255)
  location      String?   @db.VarChar(255)
  sources       String[]  @default([])
  limitPerSource Int      @default(25) @map("limit_per_source")
  status        String    @default("queued") @db.VarChar(20) // queued | running | succeeded | failed | blocked
  bullJobId     String?   @map("bull_job_id") @db.VarChar(100)
  results       Json?     @default("{}") // per-source: { found, ingested, status, message }
  startedAt     DateTime? @map("started_at") @db.Timestamptz(6)
  finishedAt    DateTime? @map("finished_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)], map: "idx_scrape_runs_user_created")
  @@map("scrape_runs")
}

/// ----------------------
/// KEEP AS-IS (already used correctly)
/// ----------------------

model analytics_daily {
  day               DateTime  @id @db.Date
  jobs_scraped      Int?      @default(0)
  jobs_matched      Int?      @default(0)
  applications_sent Int?      @default(0)
  responses         Int?      @default(0)
  response_rate_pct Decimal?  @db.Decimal(5, 1)
  refreshed_at      DateTime? @default(now()) @db.Timestamptz(6)
}

model applications {
  id                 BigInt    @id @default(autoincrement())
  job_id             BigInt?   @unique
  status             String    @default("pending") @db.VarChar(20)
  applied_at         DateTime? @db.Timestamptz(6)
  failure_reason     String?
  retry_count        Int?      @default(0)
  playwright_log     Json?
  outcome_updated_at DateTime? @db.Timestamptz(6)
  created_at         DateTime? @default(now()) @db.Timestamptz(6)
  jobs               jobs?     @relation(fields: [job_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([applied_at(sort: Desc)], map: "idx_applications_applied_at")
  @@index([outcome_updated_at(sort: Desc)], map: "idx_applications_outcome_updated_at")
  @@index([status], map: "idx_applications_status")
}

model companies {
  id              Int       @id @default(autoincrement())
  name            String    @db.VarChar(255)
  normalized_name String    @unique @db.VarChar(255)
  domain          String?   @db.VarChar(255)
  created_at      DateTime? @default(now()) @db.Timestamptz(6)
  jobs            jobs[]

  @@index([normalized_name], map: "idx_companies_normalized")
}

model job_sources {
  id         Int       @id @default(autoincrement())
  name       String    @unique @db.VarChar(50)
  base_url   String?   @db.VarChar(255)
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  jobs       jobs[]
}

model jobs {
  id               BigInt         @id @default(autoincrement())
  company_id       Int?
  title            String         @db.VarChar(255)
  normalized_title String         @db.VarChar(255)
  description      String
  location         String?        @db.VarChar(255)
  remote_type      String?        @db.VarChar(20)
  source_id        Int?
  source_url       String         @db.VarChar(1000)
  external_job_id  String?        @db.VarChar(255)
  canonical_job_id BigInt?
  status           String?        @default("new") @db.VarChar(20)
  posted_at        DateTime?      @db.Timestamptz(6)
  scraped_at       DateTime?      @default(now()) @db.Timestamptz(6)
  content_hash     String         @db.VarChar(64)
  applications     applications?
  jobs             jobs?          @relation("jobsTojobs", fields: [canonical_job_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  other_jobs       jobs[]         @relation("jobsTojobs")
  companies        companies?     @relation(fields: [company_id], references: [id], onUpdate: NoAction)
  job_sources      job_sources?   @relation(fields: [source_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  match_scores     match_scores[]

  @@unique([source_id, external_job_id])
  @@index([company_id, normalized_title], map: "idx_jobs_company_title")
  @@index([content_hash], map: "idx_jobs_content_hash")
  @@index([posted_at(sort: Desc)], map: "idx_jobs_posted_at")
  @@index([status], map: "idx_jobs_status")
}

model match_scores {
  id           BigInt        @id @default(autoincrement())
  job_id       BigInt?
  profile_id   Int?
  method       String        @db.VarChar(20)
  score        Decimal       @db.Decimal(5, 2)
  explanation  Json?
  scored_at    DateTime?     @default(now()) @db.Timestamptz(6)
  jobs         jobs?         @relation(fields: [job_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user_profile user_profile? @relation(fields: [profile_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  // SECURITY FIX (multi-user audit, phase 12/13): was @@unique([job_id,
  // method]) — one score per job PERIOD, regardless of whose profile it
  // was scored against. With one shared global profile that was invisible;
  // once profiles are per-user (see user_profile.user_id above), the same
  // job legitimately needs one score per (job, profile, method) so two
  // users' match scores for the same job don't collide/overwrite each
  // other.
  @@unique([job_id, profile_id, method])
  @@index([score(sort: Desc)], map: "idx_match_scores_score")
}

model user_profile {
  id               Int            @id @default(autoincrement())
  // SECURITY FIX (multi-user audit, phase 12/13): this table used to have
  // no owner at all — every request read/wrote whichever single row
  // existed (`findFirst({ orderBy: { id: "asc" } })`), so every logged-in
  // user shared one resume/skill-weights and every job's match score was
  // computed against that one shared profile. `user_id` makes this
  // properly per-user. Nullable rather than required so the pre-existing
  // singleton row (if one already exists in a deployed database) isn't
  // dropped by the migration — it becomes an orphaned, unused row instead
  // of a destructive delete. Every new profile created by the app from
  // here on always sets user_id.
  user_id          Int?           @unique @map("user_id")
  full_name        String?        @db.VarChar(255)
  email            String?        @db.VarChar(255)
  resume_text      String?
  skills           String[]       @default([])
  experience_years Decimal?       @db.Decimal(3, 1)
  skill_weights    Json?          @default("{}")
  updated_at       DateTime?      @default(now()) @db.Timestamptz(6)
  match_scores     match_scores[]
  user             User?          @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id], map: "idx_user_profile_user_id")
}

/// ======================================================================
/// AI Resume Tailoring
/// The user's original resume is immutable (a new row is created when the
/// source text changes). Tailored output is stored as ResumeVersion +
/// ResumeChange rows that are applied ON TOP of the original; nothing ever
/// rewrites the original in place.
/// ======================================================================

model Resume {
  id            Int      @id @default(autoincrement())
  userId        Int      @map("user_id")
  sourceType    String   @map("source_type") @db.VarChar(20) // profile_text | upload
  label         String   @default("Original") @db.VarChar(120)
  fileName      String?  @map("file_name") @db.VarChar(255)
  mimeType      String?  @map("mime_type") @db.VarChar(100)
  fileSize      Int?     @map("file_size")
  fileSha256    String?  @map("file_sha256") @db.VarChar(64)
  // Original uploaded file bytes (<= 2 MB, validated). Never returned by list/detail APIs.
  fileData      Bytes?   @map("file_data")
  rawText       String   @map("raw_text")
  textHash      String   @map("text_hash") @db.VarChar(64)
  parsed        Json?
  parserVersion String?  @map("parser_version") @db.VarChar(20)
  parseQuality  Json?    @map("parse_quality")
  // Set when the user explicitly chooses this resume ("Use for tailoring") or
  // uploads it. The most recently activated resume is the one tailoring uses.
  activatedAt   DateTime? @map("activated_at") @db.Timestamptz(6)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  facts     ResumeFact[]
  analyses  ResumeAnalysis[]
  versions  ResumeVersion[]

  @@unique([userId, textHash], map: "uq_resumes_user_text_hash")
  @@index([userId, createdAt(sort: Desc)], map: "idx_resumes_user_created")
  @@map("resumes")
}

model ResumeFact {
  id          Int    @id @default(autoincrement())
  resumeId    Int    @map("resume_id")
  factKey     String @map("fact_key") @db.VarChar(20)
  unitId      String @map("unit_id") @db.VarChar(40)
  kind        String @db.VarChar(30)
  section     String @db.VarChar(30)
  text        String
  sourcePath  String @map("source_path") @db.VarChar(120)
  entryId     String? @map("entry_id") @db.VarChar(40)
  confidence  Float  @default(1)

  resume Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@unique([resumeId, factKey], map: "uq_resume_facts_resume_key")
  @@index([resumeId], map: "idx_resume_facts_resume")
  @@map("resume_facts")
}

model JobDescription {
  id              Int      @id @default(autoincrement())
  userId          Int      @map("user_id")
  jdHash          String   @map("jd_hash") @db.VarChar(64)
  jobKey          String?  @map("job_key") @db.VarChar(60)
  title           String   @db.VarChar(255)
  company         String   @db.VarChar(255)
  location        String?  @db.VarChar(255)
  sourceUrl       String?  @map("source_url") @db.VarChar(1000)
  sourceName      String?  @map("source_name") @db.VarChar(50)
  // sanitised original JD text, kept for verification
  rawText         String   @map("raw_text")
  parsed          Json
  taxonomyVersion String   @map("taxonomy_version") @db.VarChar(20)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  analyses ResumeAnalysis[]
  versions ResumeVersion[]

  @@unique([userId, jdHash], map: "uq_job_descriptions_user_hash")
  @@map("job_descriptions")
}

model ResumeAnalysis {
  id                Int      @id @default(autoincrement())
  userId            Int      @map("user_id")
  resumeId          Int      @map("resume_id")
  jdId              Int      @map("jd_id")
  jobKey            String   @map("job_key") @db.VarChar(60)
  taxonomyVersion   String   @map("taxonomy_version") @db.VarChar(20)
  matchScore        Int?     @map("match_score")
  matchedSkills     String[] @default([]) @map("matched_skills")
  partialSkills     String[] @default([]) @map("partial_skills")
  missingSkills     String[] @default([]) @map("missing_skills")
  unsupportedClaims Json     @default("[]") @map("unsupported_claims")
  recommendations   Json     @default("[]")
  result            Json
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  resume Resume         @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  jd     JobDescription @relation(fields: [jdId], references: [id], onDelete: Cascade)

  @@unique([resumeId, jdId, taxonomyVersion], map: "uq_resume_analyses_resume_jd_tax")
  @@index([userId, jobKey, createdAt(sort: Desc)], map: "idx_resume_analyses_user_job")
  @@map("resume_analyses")
}

model ResumeVersion {
  id            Int       @id @default(autoincrement())
  userId        Int       @map("user_id")
  resumeId      Int       @map("resume_id")
  jdId          Int       @map("jd_id")
  jobKey        String    @map("job_key") @db.VarChar(60)
  trackedJobId  Int?      @map("tracked_job_id")
  jdHash        String    @map("jd_hash") @db.VarChar(64)
  label         String    @db.VarChar(255)
  targetCompany String    @map("target_company") @db.VarChar(255)
  targetTitle   String    @map("target_title") @db.VarChar(255)
  status        String    @default("draft") @db.VarChar(20) // draft | approved | rejected
  // Resulting profile for the current status: draft = original + pending
  // changes; approved = original + accepted changes only.
  profile       Json
  matchScore    Int?      @map("match_score")
  analysis      Json
  // Immutable copy of the base profile + evidence facts this version was
  // built from, so the version stays verifiable/displayable even if the
  // parser is later upgraded.
  snapshot      Json
  unsupportedClaims Json  @default("[]") @map("unsupported_claims")
  recommendations Json    @default("[]")
  warnings      Json      @default("[]")
  aiProvider    String?   @map("ai_provider") @db.VarChar(30)
  aiModel       String?   @map("ai_model") @db.VarChar(80)
  aiUsed        Boolean   @default(false) @map("ai_used")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  approvedAt    DateTime? @map("approved_at") @db.Timestamptz(6)

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  resume  Resume         @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  jd      JobDescription @relation(fields: [jdId], references: [id], onDelete: Cascade)
  changes ResumeChange[]

  @@index([userId, createdAt(sort: Desc)], map: "idx_resume_versions_user_created")
  @@index([userId, jobKey], map: "idx_resume_versions_user_job")
  @@map("resume_versions")
}

model ResumeChange {
  id           Int      @id @default(autoincrement())
  versionId    Int      @map("version_id")
  changeKey    String   @map("change_key") @db.VarChar(20)
  position     Int      @default(0)
  section      String   @db.VarChar(30)
  op           String   @db.VarChar(20) // reorder | rewrite
  listPath     String?  @map("list_path") @db.VarChar(40)
  unitId       String?  @map("unit_id") @db.VarChar(40)
  originalText String   @map("original_text")
  proposedText String   @map("proposed_text")
  beforeIds    Json?    @map("before_ids")
  afterIds     Json?    @map("after_ids")
  reason       String
  evidenceIds  String[] @default([]) @map("evidence_ids")
  source       String   @db.VarChar(20) // deterministic | ai
  status       String   @default("pending") @db.VarChar(20) // pending | accepted | rejected
  validation   Json     @default("{}")

  version ResumeVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@unique([versionId, changeKey], map: "uq_resume_changes_version_key")
  @@index([versionId, position], map: "idx_resume_changes_version")
  @@map("resume_changes")
}

model TailoringSession {
  id         String    @id @default(uuid()) @db.VarChar(36)
  userId     Int       @map("user_id")
  resumeId   Int?      @map("resume_id")
  jobKey     String    @map("job_key") @db.VarChar(60)
  status     String    @default("queued") @db.VarChar(20) // queued | running | succeeded | failed
  stage      String    @default("queued") @db.VarChar(30)
  versionId  Int?      @map("version_id")
  error      String?
  errorCode  String?   @map("error_code") @db.VarChar(40)
  warnings   Json      @default("[]")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  finishedAt DateTime? @map("finished_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)], map: "idx_tailoring_sessions_user")
  @@map("tailoring_sessions")
}
